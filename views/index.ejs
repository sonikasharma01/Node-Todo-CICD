<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>To-Do App</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 40px; background-color: #f4f4f9; }
        .container { max-width: 400px; margin: auto; background: white; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
        ul { list-style: none; padding: 0; }
        li { display: flex; justify-content: space-between; padding: 8px 0; border-bottom: 1px solid #eee; }
        input[type="text"] { width: 70%; padding: 8px; }
        button { padding: 8px 12px; cursor: pointer; }
        .delete-btn { background-color: #ff4d4d; color: white; border: none; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="container">
        <h2>My To-Do List</h2>
        
        <!-- Form to Add Todo -->
        <form action="/add" method="POST">
            <input type="text" name="todo" placeholder="Add a new task..." required>
            <button type="submit">Add</button>
        </form>

        <!-- Display List of Todos -->
        <ul>
            <% todos.forEach((item, index) => { %>
                <li>
                    <span><%= item %></span>
                    <form action="/delete/<%= index %>" method="POST" style="display:inline;">
                        <button type="submit" class="delete-btn">Delete</button>
                    </form>
                </li>
            <% }); %>
        </ul>
    </div>
</body>
</html>